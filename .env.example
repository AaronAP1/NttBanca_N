# Copia este archivo como .env y completa los valores.

# ---------- App ----------
APP_NAME=NttBanca API
DEBUG=false

# ---------- PostgreSQL (AWS RDS) ----------
# Endpoint de la instancia RDS, p. ej. mi-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# RDS acepta SSL: require (recomendado) | verify-full | disable
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
# Crea las tablas al arrancar si no existen
DB_AUTO_CREATE_TABLES=true

# ---------- AWS / S3 ----------
AWS_REGION=us-east-1
# Si dejas las keys vacías, boto3 usa ~/.aws/credentials o el rol IAM (EC2/ECS/Lambda)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo si usas credenciales temporales (STS / SSO)
AWS_SESSION_TOKEN=
S3_BUCKET_NAME=
# Carpeta dentro del bucket donde se guardan los archivos
S3_KEY_PREFIX=uploads
S3_PRESIGNED_URL_EXPIRATION=3600
